{
	"name": "the-alan-s-data-base",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.15.1",
	"engines": {
		"node": ">=24",
		"pnpm": "11.15.1"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm test:unit -- --run && pnpm --dir worker test && pnpm test:e2e",
		"test:e2e": "playwright test",
		"test:a11y": "playwright test tests/accessibility.e2e.ts",
		"test:responsive": "playwright test tests/responsive.e2e.ts",
		"test:visual": "node scripts/run-visual-tests.mjs",
		"test:production": "node scripts/verify-production-hosts.mjs",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:bootstrap-owner": "tsx scripts/bootstrap-owner-role.ts",
		"monitor": "tsx scripts/monitor.ts",
		"sync": "tsx scripts/sync-repos.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@electric-sql/pglite": "^0.5.8",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.12",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@sentry/sveltekit": "^10.71.0",
		"@sveltejs/kit": "^2.70.3",
		"bits-ui": "2.18.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"lucide-svelte": "^1.0.1",
		"postgres": "^3.4.9",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1"
	}
}
