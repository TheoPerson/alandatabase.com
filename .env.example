# Copy this file to .env for local Development only.
# In Vercel, configure Preview and Production separately. Vercel supplies
# VERCEL, VERCEL_ENV and NODE_ENV automatically; do not override them.

# Database Configuration
DATABASE_URL=""
# Vercel/Postgres deployments may expose POSTGRES_URL instead. Preview should
# use a separate non-production database URL and never inherit production data.
POSTGRES_URL=""
PREVIEW_DATABASE_URL=""
# Explicit mutation target for operator-run worker commands. Keep unset until
# the intended database has been reviewed.
WORKER_DATABASE_URL=""
# Required only for the one-time owner bootstrap operator command. The exact
# value is documented by the runbook and should be scoped to one command.
OWNER_BOOTSTRAP_CONFIRM=""

# Meilisearch Configuration
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY=""

# TMDB API (Get your free key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=""
TMDB_READ_TOKEN=""

# UptimeRobot v3 (server-only). Use a monitor-specific or read-only key.
UPTIMEROBOT_API_KEY=""
UPTIMEROBOT_MONITOR_ID="803733856"

# Server Configuration
PORT=3000
NODE_ENV=development
# Local read-only browsing only. Never enable this in production or a hosted preview.
ALLOW_DEV_AUTH_BYPASS=false
# One-time first-owner registration key. Use at least 32 random characters,
# create the first owner, then remove it from every hosted environment.
# Runtime authorization uses the persistent users.role column, never this key.
OWNER_SETUP_KEY=""
# Required by hosted authentication. Generate a high-entropy server-only key;
# changing it resets rate-limit subject identities without affecting accounts.
RATE_LIMIT_HASH_KEY=""

# Gemini API Key
GEMINI_API_KEY=""

# Optional build-only upload token. Never expose it through a PUBLIC_ variable.
SENTRY_AUTH_TOKEN=""

# Optional Telegram integration. The webhook fails closed unless all three are set.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_ALLOWED_CHAT_IDS=""
# Default notification destination used by the server notification helper.
TELEGRAM_CHAT_ID=""
# Optional routing overrides for separate Telegram topics/channels.
TELEGRAM_CHAT_MAJOR=""
TELEGRAM_CHAT_INGEST=""
TELEGRAM_CHAT_USERS=""
TELEGRAM_CHAT_LOGS=""
TELEGRAM_TOPIC_MAJOR=""
TELEGRAM_TOPIC_INGEST=""
TELEGRAM_TOPIC_USERS=""
TELEGRAM_TOPIC_LOGS=""
