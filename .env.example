# Database Configuration
DATABASE_URL="postgres://cinema:cinema_dev_password@localhost:5432/cinema"

# Meilisearch Configuration
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="cinema_dev_meili_key_12345"

# TMDB API (Get your free key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY="your_tmdb_api_key_here"
TMDB_READ_TOKEN="your_tmdb_read_token_here"

# Server Configuration
PORT=3000
NODE_ENV=development
# Local read-only browsing only. Never enable this in production or a hosted preview.
ALLOW_DEV_AUTH_BYPASS=false
OWNER_USER_IDS="comma_separated_user_uuid_values"
OWNER_EMAILS="owner@example.com"

# Gemini API Key
GEMINI_API_KEY="YOUR_GEMINI_KEY"

# Optional Telegram integration. The webhook fails closed unless all three are set.
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_WEBHOOK_SECRET="a_long_random_webhook_secret"
TELEGRAM_ALLOWED_CHAT_IDS="your_numeric_chat_id"
