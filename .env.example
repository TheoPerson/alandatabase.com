# Database Configuration
DATABASE_URL="postgres://cinema:cinema_dev_password@localhost:5432/cinema"

# Meilisearch Configuration
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="cinema_dev_meili_key_12345"

# TMDB API (Get your free key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY="your_tmdb_api_key_here"
TMDB_READ_TOKEN="your_tmdb_read_token_here"

# Server Configuration
PORT=3000
NODE_ENV=development

# Gemini API Key
GEMINI_API_KEY="YOUR_GEMINI_KEY"

# OMDb API (optional, enriches IMDb ratings)
OMDB_API_KEY=""

# Admins: comma-separated emails allowed to edit/merge catalog entries and add custom movies.
# Leave empty and nobody can (secure default).
ADMIN_EMAILS="you@example.com"

# Telegram notifications (optional — disabled when unset)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Required for /api/telegram/webhook: must match the secret_token given to setWebhook
TELEGRAM_WEBHOOK_SECRET=""
# Optional per-category routing
TELEGRAM_CHAT_MAJOR=""
TELEGRAM_CHAT_INGEST=""
TELEGRAM_CHAT_USERS=""
TELEGRAM_CHAT_LOGS=""
TELEGRAM_TOPIC_MAJOR=""
TELEGRAM_TOPIC_INGEST=""
TELEGRAM_TOPIC_USERS=""
TELEGRAM_TOPIC_LOGS=""
